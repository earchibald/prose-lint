{
  "mcpServers": {
    "prose-lint": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/server/mcp.js"],
      "env": {
        "CLAUDE_PLUGIN_OPTION_API_KEY": "${CLAUDE_PLUGIN_OPTION_API_KEY}",
        "CLAUDE_PLUGIN_OPTION_MESSAGE_FORMAT": "${user_config.message_format}",
        "CLAUDE_PLUGIN_OPTION_WRITE_FEEDBACK": "${user_config.write_feedback}",
        "CLAUDE_PLUGIN_OPTION_COMMIT_CHECK": "${user_config.commit_check}",
        "CLAUDE_PLUGIN_OPTION_REPLY_LOG": "${user_config.reply_log}",
        "CLAUDE_PLUGIN_OPTION_SESSION_REPORT": "${user_config.session_report}"
      }
    }
  }
}
